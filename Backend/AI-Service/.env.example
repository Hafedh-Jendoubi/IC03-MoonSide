# Copy this file to .env for local (non-Docker) development.
# In Docker Compose, these are instead injected via Backend/docker-compose.yml.

# Groq API key — create one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Must match the JWT_SECRET used by User-Service / the other services
JWT_SECRET=3cfa76ef14937c1c0ea519f8fc057a80fcd04a7420f8e8bcd0a7567c272e007b

EUREKA_URI=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOST=localhost
PORT=8089
